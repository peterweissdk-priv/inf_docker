#!/usr/bin/env bash
set -e

VERSION="0.2.6"
SCRIPT_URL="https://raw.githubusercontent.com/peterweissdk/inf_docker/main/inf_docker"

# --- FUNCTIONS ---

show_version() {
    echo "inf_docker version $VERSION"
}

check_for_updates() {
    echo "🔍 Checking for updates..."
    REMOTE_VERSION=$(curl -fsSL "$SCRIPT_URL" | grep -m1 '^VERSION=' | cut -d'"' -f2)
    if [[ "$REMOTE_VERSION" != "$VERSION" ]]; then
        echo "📥 New version available: $REMOTE_VERSION (current: $VERSION)"
        echo "📦 Updating..."
        curl -fsSL "$SCRIPT_URL" -o /tmp/inf_docker
        sudo mv /tmp/inf_docker /usr/local/bin/inf_docker
        sudo chown root:root /usr/local/bin/inf_docker
        sudo chmod 755 /usr/local/bin/inf_docker
        echo "✅ Updated to version $REMOTE_VERSION"
    else
        echo "✅ Already running latest version ($VERSION)"
    fi
}

# --- CONFIGURATION ---
# Reads ENV and SECRET_PATH from ./inf.env in current working directory
# Can be overwritten with arguments: -e <ENV> -p <SECRET_PATH>
# Use -d to run docker compose in detached/daemonized mode

DAEMONIZE=false
ENV=""
SECRET_PATH=""

# Parse arguments
while getopts "de:p:uv" opt; do
    case $opt in
        d) DAEMONIZE=true ;;
        e) ENV="$OPTARG" ;;
        p) SECRET_PATH="$OPTARG" ;;
        u) check_for_updates; exit 0 ;;
        v) show_version; exit 0 ;;
        *) echo "Usage: inf_docker [-d] [-e ENV] [-p SECRET_PATH] [-u] [-v]"; exit 1 ;;
    esac
done

# Check for required dependencies
if ! command -v infisical &> /dev/null; then
    echo "❌ Error: Infisical CLI is not installed."
    echo "   Install it from: https://infisical.com/docs/cli/overview"
    exit 1
fi

if ! docker compose version &> /dev/null; then
    echo "❌ Error: Docker Compose is not installed."
    echo "   Install Docker with Compose plugin: https://docs.docker.com/compose/install/"
    exit 1
fi

# Load defaults from inf.env if it exists and values not set via arguments
INF_ENV_FILE="./inf.env"
if [[ -f "$INF_ENV_FILE" ]]; then
    # Source the file to get defaults
    source "$INF_ENV_FILE"
    # Use sourced values only if not already set via arguments
    ENV="${ENV:-$INF_ENV}"
    SECRET_PATH="${SECRET_PATH:-$INF_SECRET_PATH}"
fi

# Validate required values
if [[ -z "$ENV" || -z "$SECRET_PATH" ]]; then
    echo "❌ Error: ENV and SECRET_PATH are required."
    echo "   Provide them via ./inf.env or arguments: -e <ENV> -p <SECRET_PATH>"
    exit 1
fi

echo "🚀 Fetching secrets for environment [$ENV] at path [$SECRET_PATH]..."

# Run Infisical with variables and start Docker
if [[ "$DAEMONIZE" == true ]]; then
    infisical run --env="$ENV" --path="$SECRET_PATH" -- docker compose up -d

    echo "✅ Containers started successfully!"
    echo ""

    # Display status of the started container
    echo "📊 Started container status:"
    docker ps --filter "id=$(docker compose ps -q)" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
else
    infisical run --env="$ENV" --path="$SECRET_PATH" -- docker compose up
fi
